# The Fable Club CMS: environment variables
# Copy this file to .env.local and fill it in. One NAME=value per line, no quotes,
# no spaces around "=". Never paste real values into chat or commit them.

# --- Supabase (Project Settings -> API Keys) --------------------------------
# URL = 'Project URL'. ANON_KEY = the 'Publishable key' (sb_publishable_...) or the legacy anon key.
# Safe to be public (shipped to the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: the 'Secret key' (sb_secret_...) or the legacy service_role key. Full database access. Server only. Never share it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Publishing -------------------------------------------------------------
# SECRET: Vercel project (the PUBLIC site) -> Settings -> Git -> Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=

# --- Who can log in ---------------------------------------------------------
# Leftover note only: CMS access is decided by the admins table (docs/ACCESS.md)
ADMIN_GITHUB_USERNAMES=Haise-727
# The org repo whose collaborators may be admins (optional extra check)
GITHUB_REPO=The-Fable-Club/fable-site

# --- Login provider -----------------------------------------------------------
# The GitHub OAuth app's Client ID and Secret are entered inside the Supabase
# dashboard (Authentication -> Providers -> GitHub), NOT in this file.

# --- Optional: running migrations from this machine ---------------------------
# Direct Postgres connection string (Supabase dashboard -> Connect). A SECRET.
# Only used by scripts/db.mjs. Leave empty if you apply migrations in the SQL editor.
DATABASE_URL=

# --- Optional: emailing answers to event questions -----------------------------
# Resend (resend.com) API key (a SECRET) and a sender on a domain verified in Resend.
# Without them the Questions screen offers a mailto: link instead.
RESEND_API_KEY=
MAIL_FROM="The Fable Club <contact@thefableclub.com>"

# --- New-application alerts (migration 0010) -----------------------------------
# SECRET. The same value is stored in the Supabase vault as 'application_hook_secret'
# (docs/RECOVERY.md 3.7). The database sends it with each alert; the CMS checks it.
APPLICATION_HOOK_SECRET=

# --- ImageKit (photos and clips) -----------------------------------------------
# Dashboard -> Developer options. The URL endpoint and public key are not secret;
# the PRIVATE key is (it signs uploads). Server only.
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
